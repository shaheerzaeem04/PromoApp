# Frontend env (copy to .env.local for overrides)
#
# Dev default: leave VITE_API_URL empty or `/api` so Vite proxies to the backend.
# Vite proxy target is VITE_API_PROXY (see vite.config.ts), default http://127.0.0.1:3001
#
# If you want the browser Network tab to show the backend host directly:
#   VITE_API_URL=http://127.0.0.1:3001/api
#
# Production builds usually keep:
#   VITE_API_URL=/api
# (nginx or CDN proxies /api → backend)

VITE_API_URL=/api
VITE_API_PROXY=http://127.0.0.1:3001
VITE_DEV_PORT=5173
